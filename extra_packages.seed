# Additional optional packages (installed as modules = available but not
# preinstalled). make defconfig will drop anything this OpenWrt tree does
# not know, so it is safe to keep an aspirational list here.

CONFIG_PACKAGE_kmod-ebtables-ipv6=m
CONFIG_PACKAGE_kmod-ipt-raw6=m
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=m
CONFIG_PACKAGE_kmod-usb-net-rndis=m

CONFIG_PACKAGE_ksmbd-tools=m
CONFIG_PACKAGE_luci-app-frps=m
CONFIG_PACKAGE_luci-app-mwan3=m
CONFIG_PACKAGE_luci-app-openvpn=m
CONFIG_PACKAGE_luci-app-socat=m
CONFIG_PACKAGE_luci-app-udpxy=m
CONFIG_PACKAGE_luci-proto-bonding=m
CONFIG_PACKAGE_luci-proto-openconnect=m

CONFIG_PACKAGE_ebtables=m
CONFIG_PACKAGE_igmpproxy=m
CONFIG_PACKAGE_node=m
CONFIG_PACKAGE_node-npm=m
CONFIG_PACKAGE_smartmontools-drivedb=m
CONFIG_PACKAGE_usbutils=m
CONFIG_PACKAGE_xl2tpd=m
CONFIG_PACKAGE_zram-swap=m
