# NanoPi R2S target (OpenWrt 25.12+)
CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_rockchip_armv8_DEVICE_friendlyarm_nanopi-r2s=y

# Rootfs / image
CONFIG_TARGET_ROOTFS_PARTSIZE=800
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_TARGET_IMAGES_GZIP=y

# CPU tuning (RK3328, Cortex-A53)
CONFIG_TARGET_OPTIONS=y
CONFIG_TARGET_OPTIMIZATION="-O2 -pipe -march=armv8-a+crypto+crc -mcpu=cortex-a53+crypto+crc -mtune=cortex-a53"

# LuCI core features commonly expected on R2S
CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_luci-app-statistics=y
CONFIG_PACKAGE_collectd-mod-ping=y
CONFIG_PACKAGE_collectd-mod-thermal=y

# Proxy / science-net toolchain (third-party feeds, merged by merge_packages.sh)
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-openclash=y

# NIC drivers useful on R2S / USB tethering
CONFIG_PACKAGE_kmod-r8168=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152-vendor=y

# USB Wi-Fi dongles commonly used on R2S
CONFIG_PACKAGE_kmod-ath9k-htc=y
CONFIG_PACKAGE_kmod-mt76x0u=y
CONFIG_PACKAGE_kmod-mt76x2u=y
CONFIG_PACKAGE_kmod-rtw88-usb=y
CONFIG_PACKAGE_kmod-rtl8xxxu=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_wpad-openssl=y
CONFIG_DRIVER_11AC_SUPPORT=y
CONFIG_DRIVER_11N_SUPPORT=y
CONFIG_DRIVER_11W_SUPPORT=y

# Optional OLED status plugin (metal case variants). Guarded as module so
# missing upstream package will not break defconfig.
CONFIG_PACKAGE_luci-app-oled=m
